# Python packages live in .venv; this file configures the application.
# Process environment overrides .env. Values are literal; no shell expansion.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_ALIAS=cartoons
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=10
EMBEDDING_REVISION=fd1525a9fd15316a2d503bf26ab031a61d056e98
MODEL_CACHE=.cache/models
EMBEDDING_THREADS=2
CHUNK_CHARS=1200

# Gemini API: use a Free Tier project without billing enabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GENERATION_TIMEOUT_SECONDS=30
GENERATION_MAX_OUTPUT_TOKENS=2048
